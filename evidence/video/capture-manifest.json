  "segments": [
    {
      "seconds": 10,
      "title": "A compatibility guardian for AI agents",
      "text": "PatchCourt catches silent compatibility regressions at the framework-to-provider boundary.\nThis is a real local OFFLINE recording. No live model inference is shown.",
      "start": 0
    },
    {
      "seconds": 12,
      "title": "The adapter drops a tool call",
      "text": "The first case executes a pinned upstream NVIDIA adapter function locally.\nThe candidate loses tool calls while their results remain: a broken protocol.",
      "start": 10
    },
    {
      "seconds": 10,
      "title": "Executable evidence explains the failure",
      "text": "The findings identify orphan tool results and missing calls.\nThis is a protocol verdict backed by recorded execution, not an LLM opinion.",
      "start": 22
    },
    {
      "seconds": 10,
      "title": "A repair must earn its verdict",
      "text": "A deterministic local repair preserves the structured tool calls.\nThe replay passes after repair; this patch was not generated by a model.",
      "start": 32
    },
    {
      "seconds": 12,
      "title": "Task-level impact: value restored to 21",
      "text": "Before repair, the inventory task cannot associate requests with results.\nAfter repair, the deterministic replay restores the inventory value to 21.",
      "start": 42
    },
    {
      "seconds": 10,
      "title": "A second boundary: image content loss",
      "text": "The CrewAI source case exposes an image reference lost during formatting.\nA successful API response alone would not prove that image semantics survived.",
      "start": 54
    },
    {
      "seconds": 10,
      "title": "Traceable source, bounded claims",
      "text": "The provenance records upstream source, hashes, and the execution boundary.\nSource-function evidence is narrower than full SDK or production verification.",
      "start": 64
    },
    {
      "seconds": 10,
      "title": "Reuse knowledge, recheck the contract",
      "text": "Verified observations are saved with version, source, and environment scope.\nKnowledge reuse never skips executing the current compatibility contract.",
      "start": 74
    },
    {
      "seconds": 10,
      "title": "Live reliability remains BLOCKED",
      "text": "Nebius/Nemotron and Tavily credentials are unavailable. The live lab is BLOCKED.\nThis demo claims no live inference, model benchmark, or retrieval improvement.",
      "start": 84
    },
    {
      "seconds": 10,
      "title": "Evidence before submission claims",
      "text": "Acceptance gates expose what passed and what still needs evidence.\nLocal repairs and controlled mutations do not establish universal compatibility.",
      "start": 94
    },
    {
      "seconds": 8,
      "title": "Inspect, reproduce, and challenge the evidence",
      "text": "Source: github.com/karurukaruru/agent-code-validator\nRun: python -m patchcourt demo --output outputs/demo",
      "start": 104
    }
  ],
  "limitations": [
    "Recorded existing local execution evidence; does not execute the SDK again while recording",
    "2 fps capture; 30 fps output duplicates frames for player compatibility",
    "No live Nebius, Nemotron or Tavily calls",
    "No public video upload"
  ]
